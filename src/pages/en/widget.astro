---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { t } from '../../i18n/ui';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/state-finder/" title="Sterile processing certification rules by state" width="100%" height="720" style="border:0;max-width:1000px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the sterile processing state finder on your site" description="Put the free sterile processing state finder on a school, hospital or workforce site: one iframe, the rule of every state with its date, no sign-up, no tracking and no cost." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: t(lang).breadcrumbHome, path: route('home', lang) }, { name: 'Embed', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Embed' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the state finder</h1>
    <p class="mt-3 text-lg text-navy-700">For sterile processing programs, hospital recruiters, workforce boards and career counselors.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Certification rules by state</h2>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Conditions: keep the credit line under the frame visible and use the finder as it is, without warranty. When a state passes or changes a law, the frame follows. Nothing typed leaves the visitor's browser, and the frame sets no cookie. It states that the site is independent of HSPA, the CBSPD and the states. Questions: <a href={route('contact', lang)}>contact</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200"><iframe src="/embed/state-finder/" title="Sterile processing certification rules by state" width="100%" height="720" style="border:0" loading="lazy"></iframe></div>
</PageLayout>
