---
/**
 * Home: the state finder first (which of the 50 states and DC has a certification text, and what it asks),
 * then the seven texts, the two national exams, the cost, the steps, renewal and every page by group.
 * Every figure is read from params-2026.json through the helpers.
 */
import PageLayout from '../layouts/PageLayout.astro';
import Tool from './Tool.astro';
import Clamp from './Clamp.astro';
import Sources from './Sources.astro';
import { route, hasRoute } from '../i18n/routes';
import { PAGES } from '../lib/guides';
import { GROUPS_ORDER, groupLabel } from '../i18n/nav';
import { helpers } from '../lib/helpers';
import { t } from '../i18n/ui';
import { LAST_UPDATED, AUTHOR_NAME } from '../data/site-config';
import { displayDate } from '../lib/format';
import { faqSchema, webApplicationSchema, websiteSchema, organizationSchema } from '../lib/seo';
const lang = 'en';
const ui = t(lang);
const h = helpers(lang, !process.env.LAX);
const { C, D } = h;
const cards = (g: (typeof GROUPS_ORDER)[number]) => PAGES.filter((p) => p.group === g).map((p) => ({ href: route(p.id, lang), name: p.en.nav, text: p.en.card }));
const href = (id: string) => (hasRoute(id, lang) ? route(id, lang) : route('home', lang));
const a = (id: string, text: string) => `<a href="${href(id)}">${text}</a>`;
const st = h.state;
const WORDS = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight'];
const nInForce = WORDS[h.inForce.length], nTexts = WORDS[h.STATES.length], nCe = WORDS[h.withCe.length];
const mn = h.upcoming[0];
const pr = h.pr('crcst', 2025), prD = h.pr('cspdt', 2025);
const areasText = (C.handsOn.areas as Array<[string, number]>).map(([n, v]) => `${n.toLowerCase()} ${v}`).join(', ');
const title = 'Sterile Processing Technician: Rules by State, CRCST, CSPDT';
const description = 'Sterile processing technician rules in every state: the 7 with a certification law, your deadline after hire, CRCST and CSPDT fees, exam format and renewal.';
const faqs = [
  { q: 'Which states require sterile processing technicians to be certified?', a: `Seven have a law or rule: New York since ${h.date(st('new-york').effective)}, New Jersey through its hospital licensing rule, Connecticut since ${h.date(st('connecticut').effective)}, Tennessee since ${h.date(st('tennessee').effective)}, Pennsylvania since ${h.date(st('pennsylvania').effective)}, Delaware since ${h.date(st('delaware').effective)}, and Minnesota, whose statute took effect in December 2025 but reaches only people hired from January 1, 2028. Sources that say two states are out of date.` },
  { q: 'How long do I have to get certified after I am hired?', a: `It depends on the state: ${st('new-york').graceMonths} months in New York, Pennsylvania and Delaware, ${st('connecticut').graceMonths} months in Connecticut, Tennessee and Minnesota, and three years in New Jersey hospitals. The deadline calculator on each state page turns your month of hire into a date.` },
  { q: 'What is the difference between the CRCST and the CSPDT?', a: `The CRCST comes from the Healthcare Sterile Processing Association (HSPA), needs ${h.num(C.handsOn.total)} hands-on hours, can be taken any day at a Prometric center and renews yearly. The CSPDT comes from the Certification Board for Sterile Processing and Distribution (CBSPD), accepts a year of work or a course passed with 70, is held in four testing weeks a year and renews every five years. State texts accept both.` },
  { q: 'How much does sterile processing certification cost?', a: `${h.usd(C.fee)} for the CRCST exam, of which ${h.usd(C.feeNonRefundable)} is not refundable, and ${h.usd(D.feeWeb)} for the CSPDT on the CBSPD exam page (${h.usd(D.feeBulletin)} in its 2026 bulletin). Then ${h.usd(C.renewal.fee)} a year to keep the CRCST, or ${h.usd(D.recertFee)} every five years for the CSPDT. A course is optional for the CRCST.` },
  { q: 'Can I work in sterile processing without certification?', a: 'In 43 states and DC no state law requires it, so the employer decides; many ask for the credential at hire or within months. In the seven states with a law, you can usually be hired without it but must earn it within the deadline, unless you qualify by earlier employment.' },
  { q: 'Is this site part of HSPA or the CBSPD?', a: 'No. Sterile Processing By State is published independently by Radif Partners. Applications, fees and exam bookings go through HSPA or the CBSPD, and state questions go to your employer or the state health department. The site sells nothing, needs no account, and the calculators run in your browser without sending what you type.' },
];
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webApplicationSchema({ name: 'Sterile processing certification state finder', description, path: route('home', lang), lang }), faqSchema(faqs, lang)];
const resume = `A sterile processing technician, called a central service technician in most laws, reprocesses the reusable instruments of hospitals and surgery centers: cleaning, inspecting, packaging, sterilizing, storing and delivering them. No state issues its own license for the job. What exists is a national credential, the CRCST of the Healthcare Sterile Processing Association (HSPA) or the CSPDT of the Certification Board for Sterile Processing and Distribution (CBSPD), and seven states with a law or rule that makes one of them a condition of employment within a set time after hire. ${nInForce.charAt(0).toUpperCase() + nInForce.slice(1)} apply it today; ${mn.name}'s reaches people hired from ${h.date(mn.bitesFrom ?? mn.effective)}. The finder above tells you which law applies in your state, from when and what it asks. Every date, fee and rule on this site links to the statute, rule or handbook where it was read, on ${h.read}. This site is independent: it is not HSPA, the CBSPD or a state agency.`;
---
<PageLayout title={title} description={description} lang={lang} jsonLd={jsonLd} faqs={faqs} breadcrumbs={[]}>
  <header class="mb-3">
    <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-accent-600">Central service · sterile processing · 50 states and DC</p>
    <h1 class="mt-0 text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">Sterile processing technician rules in your state</h1>
    <p class="mt-2 text-base text-navy-700 sm:text-lg">{nTexts.charAt(0).toUpperCase() + nTexts.slice(1)} states require sterile processing technicians, who clean and sterilize the instruments hospitals reuse, to hold a national certificate: {nInForce} apply it today, and {mn.name} starts with people hired from {h.date(mn.bitesFrom ?? mn.effective)}. Pick your state for your answer: a new hire gets {st('pennsylvania').graceMonths} to {st('new-jersey').graceMonths} months to earn the certificate.</p>
    <div class="mt-2 rounded-md border border-navy-200 bg-navy-50 px-3 py-2 text-sm text-navy-800" data-sigles>
      <p class="font-semibold text-navy-900">What do these letters mean?</p>
      <ul class="mt-1 space-y-1">
        <li><details><summary class="cursor-pointer list-none"><strong>CRCST</strong>: a certificate, given by <strong>HSPA</strong>, an association <span class="text-xs text-accent-700">▾ full names</span></summary><p class="text-xs text-navy-600">Certified Registered Central Service Technician, given by the Healthcare Sterile Processing Association</p></details></li>
        <li><details><summary class="cursor-pointer list-none"><strong>CSPDT</strong>: a certificate, given by the <strong>CBSPD</strong>, a board <span class="text-xs text-accent-700">▾ full names</span></summary><p class="text-xs text-navy-600">Certified Sterile Processing and Distribution Technician, given by the Certification Board for Sterile Processing and Distribution</p></details></li>
      </ul>
      <p class="mt-1 text-xs">Both are national; every state law that names a certificate accepts either.</p>
    </div>
    <p data-chrome data-independant class="mt-1 text-xs font-medium text-navy-600">{ui.independent}</p>
  </header>
  <div data-outil id="calculator" class="mb-4 scroll-mt-20"><Tool tool={{ kind: 'states', props: { state: 'Pennsylvania' } }} primary={true} seedKey="home" /></div>
  <p class="mb-4 text-sm"><a href="#steps" class="font-medium text-accent-700 underline">New to this job? The five steps to get certified →</a></p>
  <Clamp text={resume} id="clamp-home" lang={lang} class="mb-3" />
  <p class="mb-8 text-sm text-navy-600">State texts, fees and exam rules checked on <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, 'en-US')}</time> · {AUTHOR_NAME} · <a href={route('method', lang)} class="underline hover:text-navy-900">How we read the laws</a> · <a href={route('about', lang)} class="underline hover:text-navy-900">About this site</a></p>

  <div class="prose prose-slate max-w-none">
    <h2>The seven state laws and their dates</h2>
    <p>Most articles still say that only New York and New Jersey require certification. That was true around 2015. Since then Connecticut, Tennessee, Pennsylvania, Delaware and Minnesota have passed their own laws. We read each one on the legislature or health department site and give the date it took effect, not the date it was introduced.</p>
    <Fragment set:html={h.stateTable(`Laws read on ${h.read}. For New Jersey, the date is the rule's last update; the duty itself is older.`)} />
    <p>Tap a state name in the list for its own page: the law in plain words, who is covered, who is exempt, and a calculator that turns your month of hire into a deadline. The <Fragment set:html={a('sterile-processing-certification-by-state', 'comparison page')} /> lays the seven side by side, and the <Fragment set:html={a('states-without-a-certification-law', 'page on the other states')} /> lists the other {h.others.length - 1} states and DC, which have no such law, and the bills that failed, such as Florida's Senate Bill 1034, which died in committee in March 2026.</p>

    <h2>What a sterile processing technician does</h2>
    <p>The work follows reusable instruments around a closed loop. Soiled trays come back from the operating rooms to the decontamination area, where technicians in protective equipment clean them by hand and in washers and ultrasonic cleaners. In the clean preparation area, each instrument is inspected under light and magnification, tested, assembled into its set from a count sheet and wrapped or placed in a rigid container with an internal indicator. Steam or low-temperature sterilizers then run the loads, and the technician reads the cycle record, the chemical indicators and, when required, the biological indicator before release. Sterile items are stored under controlled conditions and delivered on case carts. Every step leaves a record, so a single tray can be traced back to its load and its operator.</p>
    <p>The job titles vary: sterile processing technician, central service technician, SPD (sterile processing department) technician, central sterile technician, sterile processing and distribution technician. State laws use "central service technician". The certifications use both terms.</p>

    <h2>What the state laws have in common</h2>
    <p>Six of the seven laws follow one model. A hospital or ambulatory surgery center may employ someone as a central service technician only if that person passed a nationally accredited exam and holds a credential such as the CRCST or the CSPDT, was already working as a technician before the law began, or is a student or intern under supervision. A new hire who does not qualify gets a fixed period to obtain the credential, and every technician completes ten hours of continuing education a year. New Jersey is different: it puts the duty in its hospital licensing rule, allows three years from employment and requires the department head to be certified too.</p>
    <ul>
      <li><strong>Time after hire:</strong> {st('new-york').graceMonths} months in New York, Pennsylvania and Delaware; {st('connecticut').graceMonths} months in Connecticut, Tennessee and Minnesota; {st('new-jersey').graceMonths} months in New Jersey.</li>
      <li><strong>Earlier employment:</strong> a cut-off date in Connecticut, Tennessee, Pennsylvania, Delaware and Minnesota; a cumulative year in the four years before 2015 in New York; nothing in New Jersey's current rule.</li>
      <li><strong>Facilities:</strong> hospitals everywhere; ambulatory surgery centers in all but New Jersey; federal facilities excluded explicitly in Pennsylvania.</li>
      <li><strong>Exceptions for trained staff:</strong> Connecticut and Tennessee let infection prevention committees train and approve staff outside central service.</li>
    </ul>

    <h2>The two national certifications</h2>
    <p>Every text that names a credential accepts both the CRCST and the CSPDT. Minnesota adds two endoscope credentials. The exams look alike on paper: {C.items} multiple-choice questions, of which {C.scored} count and {C.unscored} are unscored pretest items, in {C.minutes / 60} hours. They differ in how you qualify, when you can test, and how you keep the credential.</p>
    <Fragment set:html={h.table(['', 'CRCST (HSPA)', 'CSPDT (CBSPD)'], [
      ['Full name', C.name, D.name],
      ['To qualify', `${h.num(C.handsOn.total)} hands-on hours, before or within ${C.handsOn.provisionalMonths} months after the exam`, '12 months of work, a course passed with 70, or two other routes'],
      ['When you test', `Any day at a Prometric center, within ${C.windowDays} days of approval`, 'One week per quarter'],
      ['Exam fee', h.usd(C.fee), `${h.usd(D.feeWeb)}<span class="block text-xs text-navy-600">fee on the CBSPD exam page; its 2026 bulletin says ${h.usd(D.feeBulletin)}</span>`],
      ['Pass mark', 'Not published: you see pass or fail on screen', `Scaled score of ${D.passScaled}`],
      ['2025 pass rate', h.pc(pr.rate, 1), h.pc(prD.rate, 1)],
      ['Renewal', `Each year: ${C.renewal.ceHours} continuing education credits and ${h.usd(C.renewal.fee)}`, `Every ${D.certYears} years: ${D.recertPoints} points and ${h.usd(D.recertFee)}`],
      [`The ${st('new-york').ceHours} hours a year of ${nCe} state laws`, 'A separate rule from this renewal; the same courses can often count for both', 'A separate rule from this recertification; the same courses can often count for both'],
      ['Current holders, end of 2025', h.num(h.P.stats.crcst.current), h.num(h.P.stats.cspdt.current)],
    ], `HSPA Certification Handbook (revised January 2026), CRCST page and statistics; CBSPD technician page, 2026 bulletin and statistics; read on ${h.read}.`, ['l', 'l', 'l'])} />
    <p>For most people the choice comes down to two things: what the employer names, and what is practical. With a manager willing to sign hours, the CRCST can be taken soon. With a graded course and no year of work, the CSPDT is open sooner. The <Fragment set:html={a('sterile-processing-technician-certification', 'comparison page')} /> has a calculator that checks which exam you can sit today.</p>

    <h2 id="steps">How to get there, step by step</h2>
    <ol>
      <li><strong>Find out what your state asks.</strong> Use <a href="#calculator">the state finder at the top of this page</a>. If your state has no law, read the job postings you are aiming at.</li>
      <li><strong>Get into a department.</strong> A trainee job, a school externship or volunteering all count toward HSPA's hours if a manager above you witnesses and signs them.</li>
      <li><strong>Log the {h.num(C.handsOn.total)} hours</strong> in five areas: {areasText}. Or test first and send them within {C.handsOn.provisionalMonths} months as a provisional CRCST.</li>
      <li><strong>Apply and book.</strong> HSPA takes about {C.processingWeeks} weeks to process an application and then gives {C.windowDays} days to sit the test; it advises booking at least 45 days before that ends. CBSPD applications are printed and mailed before a window's deadline.</li>
      <li><strong>Keep it.</strong> Renew the CRCST each year by the end of your anniversary month, or the CSPDT every five years, and log the ten yearly hours your state may require.</li>
    </ol>
    <p>The <Fragment set:html={a('how-to-become-a-sterile-processing-technician', 'step-by-step guide')} /> and the <Fragment set:html={a('sterile-processing-technician-training', 'training page')} /> go into each step with calculators for hours and dates.</p>

    <h2>The cost, all in</h2>
    <p>The certification bodies' fees are modest compared with a course. A first CRCST attempt costs {h.usd(C.fee)}; each retake costs the same again, six weeks or more later. Over five years, one attempt and four yearly renewals add up to {h.usd(C.fee + 4 * C.renewal.fee)}. The CSPDT costs {h.usd(D.feeWeb)} and {h.usd(D.recertFee)} at five years. Courses, books and travel come on top, and many employers pay the exam. The <Fragment set:html={a('sterile-processing-certification-cost', 'cost calculator')} /> adds the lines for your route, attempts and years.</p>

    <h2>Pass rates and preparation</h2>
    <p>HSPA reported {h.num(pr.pass)} passes and {h.num(pr.fail)} failures on the CRCST in 2025, a pass rate of {h.pc(pr.rate, 1)}. The CBSPD reported {h.pc(prD.rate, 1)} for the CSPDT. One candidate in three or more does not pass, which is a full fee and at least six weeks lost. Preparation pays. Our free <Fragment set:html={a('crcst-practice-test', 'practice questions')} /> are written from the public CRCST outline, section by section, with an explanation for every answer, and the <Fragment set:html={a('crcst-mock-exam', 'mock exam')} /> times 50 of them at the real pace. They are our own questions, never copies of the live exam.</p>
    <Fragment set:html={h.outline(`CRCST content outline, read on ${h.read}.`)} />

    <h2>After certification</h2>
    <p>The CRCST is renewed every year with {C.renewal.ceHours} technical continuing education credits and {h.usd(C.renewal.fee)}, by the last day of the month you were certified. Late renewal suspends the credential for a six-week grace period, after which only a new exam restores it. The CSPDT lasts five years and is renewed with {D.recertPoints} points, up to half from work. {nCe.charAt(0).toUpperCase() + nCe.slice(1)} of the {nTexts} state laws also ask for ten hours of education a year. That state rule and HSPA's {C.renewal.ceHours} yearly credits are separate, but the same courses can often count for both. See <Fragment set:html={a('crcst-renewal', 'CRCST renewal')} /> and <Fragment set:html={a('cbspd-recertification', 'CBSPD recertification')} />.</p>
    <h2>Every page of the site</h2>
  </div>
  <div class="not-prose mt-4 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-sommaire>
    {GROUPS_ORDER.map((g) => (
      <section><h3 class="mb-2 text-lg font-semibold text-navy-900">{groupLabel(g)}</h3><ul class="space-y-2 text-sm">{cards(g).map((c) => <li><a href={c.href} class="font-medium text-accent-700 underline">{c.name}</a><span class="block text-navy-700">{c.text}</span></li>)}</ul></section>
    ))}
  </div>
  <div class="prose prose-slate mt-8 max-w-none">
    <h2>Independent, and what that means</h2>
    <p>{AUTHOR_NAME} publishes this site on its own. It is not the Healthcare Sterile Processing Association, the Certification Board for Sterile Processing and Distribution, Prometric, a state health department, a school or an employer, and it sells nothing. State rules are summaries of the texts we link to, not legal advice: when a deadline matters to your job, confirm it with your employer or the state. When a fee, a date or a law changes, the parameter file changes and every page follows.</p>
    <Sources lang={lang} intro="The state rules, fees and exam facts on this site were read in these statutes, rules and documents of the certification bodies, on" />
  </div>
</PageLayout>
